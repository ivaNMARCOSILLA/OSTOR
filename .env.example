# Maggy · parámetros del servidor. Ninguna clave musical requerida.
AUDIUS_APP_NAME=maggy
SEARCH_CACHE_SECONDS=300
ARCHIVE_CACHE_SECONDS=3600
MAGGY_DATA_DIR=.instance
# Solo usar 0 para pruebas HTTP locales; producción HTTPS siempre 1.
MAGGY_COOKIE_SECURE=1

# Vercel: configurar valores privados en Environment Variables.
# SQLite local se usa solo cuando DATABASE_URL no está configurada.
DATABASE_URL=
# Opcional si ya hay un SECRET_KEY fuerte; obligatorio en Vercel si no lo hay.
MAGGY_SESSION_SECRET=

# Vídeo en directo. Configurar SOLO en variables privadas del servidor.
# Sin estos datos no se ofrecen altas de Streamer de 8 EUR.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Activar solo después de probar vídeo real en una vista previa.
MAGGY_STREAMERS_ENABLED=0
# Cobros Streamer: activar solo después de una prueba real satisfactoria.
MAGGY_STREAMER_SALES_ENABLED=0
