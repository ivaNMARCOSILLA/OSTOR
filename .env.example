# Maggy · parámetros del servidor. Ninguna clave musical requerida.
AUDIUS_APP_NAME=maggy
SEARCH_CACHE_SECONDS=300
ARCHIVE_CACHE_SECONDS=3600
MAGGY_DATA_DIR=.instance
# Solo usar 0 para pruebas HTTP locales; producción HTTPS siempre 1.
MAGGY_COOKIE_SECURE=1

# Vercel: configurar valores privados en Environment Variables.
# SQLite local se usa solo cuando DATABASE_URL no está configurada.
DATABASE_URL=
# Opcional si ya hay un SECRET_KEY fuerte; obligatorio en Vercel si no lo hay.
MAGGY_SESSION_SECRET=

# Vídeo en directo. Configurar SOLO en variables privadas del servidor.
# Sin estos datos no comienza la prueba ni se ofrecen cobros de Ol Live.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Activar solo después de probar vídeo real en una vista previa.
MAGGY_STREAMERS_ENABLED=0
# Cobros Streamer: activar solo después de una prueba real satisfactoria.
MAGGY_STREAMER_SALES_ENABLED=0

# Ol · avisos del administrador a normalesoutro@gmail.com.
# Añadir los valores reales SOLO en Vercel Environment Variables, nunca en Git.
OL_EMAIL_FROM=
# Opción A: SMTP con TLS (465) o STARTTLS (587). En Gmail, contraseña de aplicación.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Opción B: Resend, con remitente autorizado por el proveedor.
RESEND_API_KEY=

# Gestor de pagos: SOLO servidor. No activa cobros hasta la verificación real.
OL_PAYMENT_PROVIDER=stripe
OL_PAYMENTS_ENABLED=0
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
OL_MAINTENANCE=0
# Huella real de Play App Signing; sin huella no se publica assetlinks.
OL_ANDROID_PACKAGE=com.electronicama.ol
OL_ANDROID_SHA256=

# Sandbox separado: solo administrador, nunca concede acceso ni ingresos reales.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
